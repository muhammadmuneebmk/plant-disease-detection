KINDWISE_API_KEY=your_api_key_here
# Optional: used automatically when the main key runs out of credits
KINDWISE_API_KEY_BACKUP=

# Fallback AI (used only when Kindwise's disease confidence is below CONFIDENCE_THRESHOLD)
FALLBACK_PROVIDER=gemini
CONFIDENCE_THRESHOLD=0.5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
